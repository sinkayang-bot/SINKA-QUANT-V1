# Isolated authenticated read-only diagnostics. No order or paper-engine code.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115,<1" "uvicorn>=0.30,<1" "httpx>=0.27,<1" "firebase-admin>=6.5,<8"
COPY firebase_auth.py okx_readonly.py okx_orders.py okx_pending_orders.py okx_smoke.py okx_assets.py okx_status_app.py ./
ENV PYTHONUNBUFFERED=1
# PORT is supplied by Cloud Run. Credentials are runtime secret references only.
CMD ["sh", "-c", "exec uvicorn okx_status_app:app --host 0.0.0.0 --port ${PORT:-8080} --no-access-log"]
