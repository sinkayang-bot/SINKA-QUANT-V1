FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir httpx==0.28.1 && useradd --uid 10001 --create-home appuser && mkdir /data && chown 10001:10001 /data
COPY okx_demo_*.py okx_strategy_bridge.py okx_risk.py okx_instruments.py okx_orders.py okx_reconcile.py ./
USER 10001:10001
ENTRYPOINT ["python","okx_demo_reconciliation_worker.py"]
