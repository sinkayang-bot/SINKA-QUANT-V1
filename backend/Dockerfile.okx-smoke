# Isolated OKX demo-only GET smoke checker, NOT a trading service.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "httpx>=0.27,<1"
COPY okx_readonly.py okx_orders.py okx_pending_orders.py okx_smoke.py ./
ENV PYTHONUNBUFFERED=1
# No credentials or API URL are baked into the image.
# Service operators must inject read-only credentials at execution time.
CMD ["python", "okx_smoke.py"]
