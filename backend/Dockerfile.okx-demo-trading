FROM node:22-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir httpx==0.28.1 \
    && useradd --uid 10001 --create-home worker \
    && mkdir -p /app/backend /app/strategy /data \
    && chown worker:worker /data
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /app/backend
COPY backend/okx_demo_*.py ./
COPY backend/okx_strategy_bridge.py backend/okx_instruments.py backend/okx_risk.py backend/okx_orders.py backend/okx_reconcile.py ./
COPY strategy/demo-signal.mjs strategy/demo-market-scan.mjs strategy/demo-strategies.mjs strategy/public-market.mjs strategy/snr-engine.mjs /app/strategy/
ENV RUN_DEMO_TRADING=0 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER worker
CMD ["python","okx_demo_trading_worker.py"]
