FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY firestore_app.py firestore_ledger.py firebase_auth.py firestore_monitor.py monitor_lease.py leased_monitor.py ./
ENV PYTHONUNBUFFERED=1
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn firestore_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
